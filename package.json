{
  "name": "olsme-tv",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build --webpack",
    "start": "next start -p 9002",
    "lint": "eslint src functions/src --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit --project functions/tsconfig.json",
    "check:lint": "eslint src",
    "check:lint:functions": "npm --prefix functions run lint",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:types:functions": "tsc --noEmit --project functions/tsconfig.json",
    "check:security": "npm audit --audit-level=moderate",
    "check": "npm run check:lint && npm run check:types && npm run check:security",
    "precommit": "npm run check"
  },
  "dependencies": {
