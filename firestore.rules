// Path: firestore.rules
// Improvements (Oct 2, 2025):
// - Added `ratings` collection for guest rating feature.
// - Kept existing rules for `users`, `prompts`, `reports`, etc.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      // Users may update only non-subscription, non-privilege fields on their own document.
      // Subscription status, tier, package and status are server-written (Cloud Functions)
      // and must not be writable by clients to prevent self-upgrade exploits.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subscriptionStatus', 'subscriptionTier', 'status', 'package', 'startDate', 'paypalOrderId']);
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    match /prompts/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /reports/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /control_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /politeness_scores/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /biofeedback_events/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /image_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ipfs_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /logs/{document=**} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /premium_content/{document=**} {
      allow read, write: if request.auth != null && (request.auth.token.isPremium == true || request.auth.token.verificationLevel == 'gold');
    }
    match /ratings/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /mail/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /user_status/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /messages/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
