// Path: firestore.rules
// Improvements (Oct 2, 2025):
// - Added `ratings` collection for guest rating feature.
// - Kept existing rules for `users`, `prompts`, `reports`, etc.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Server-managed subscription/premium fields that clients must not set or modify.
      // These are written exclusively by Cloud Functions (updateSubscriptionStatus, etc.).
      function serverManagedFields() {
        return ['isPremium', 'subscriptionTier', 'subscriptionStatus',
                'package', 'startDate', 'paypalOrderId'];
      }

      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow creating own document (e.g. during signup) but not with subscription fields.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(serverManagedFields());

      // Allow updating own document but prevent changing any subscription/premium field.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasNone(serverManagedFields());
    }
    match /subscriptions/{uid} {
      // Only the authenticated owner can read their own subscription document.
      allow read: if request.auth != null && request.auth.uid == uid;
      // Only server/admin (identified via custom claim) can modify subscription documents.
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    match /users/{userId}/{subcollection=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /prompts/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /reports/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /control_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /politeness_scores/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /biofeedback_events/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /image_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ipfs_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /logs/{document=**} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /premium_content/{document=**} {
      allow read, write: if request.auth != null && (request.auth.token.isPremium == true || request.auth.token.verificationLevel == 'gold');
    }
    match /ratings/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /mail/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /user_status/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /messages/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /referrals/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }
  }
}
