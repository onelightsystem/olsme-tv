// Path: firestore.rules
// Improvements (Oct 2, 2025):
// - Added `ratings` collection for guest rating feature.
// - Kept existing rules for `users`, `prompts`, `reports`, etc.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true if the incoming write does not touch server-managed subscription fields.
    function noSubscriptionFieldsChanged(data) {
      return !data.hasAny(['subscriptionStatus', 'subscriptionTier', 'paypalOrderId', 'startDate', 'status', 'package']);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // Clients may only create their own profile without subscription fields.
      allow create: if request.auth != null && request.auth.uid == userId
        && noSubscriptionFieldsChanged(request.resource.data.keys());
      // Clients may update their own profile but cannot change subscription fields.
      allow update: if request.auth != null && request.auth.uid == userId
        && noSubscriptionFieldsChanged(request.resource.data.diff(resource.data).affectedKeys());
    }
    match /users/{userId}/{subcollection=**} {
      allow read, write: if request.auth != null;
    }
    match /prompts/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /reports/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /control_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /politeness_scores/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /biofeedback_events/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /image_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ipfs_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /logs/{document=**} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /premium_content/{document=**} {
      allow read, write: if request.auth != null && (request.auth.token.isPremium == true || request.auth.token.verificationLevel == 'gold');
    }
    match /ratings/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /mail/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /user_status/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /messages/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
