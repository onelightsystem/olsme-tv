{
  "functions": {
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint"], // Add linting
    "source": "functions",
    "runtime": "nodejs20" // For AI matching (Day 4)
  },
  "hosting": {
    "public": ".next", // Update for Next.js SSR (not 'out')
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html" // Support dynamic routes
      }
    ]
  },
  "emulators": {
    "functions": { "port": 5002 },
    "hosting": { "port": 9002 },
    "auth": { "port": 9099 }, // Add for Auth testing
    "firestore": { "port": 8080 }, // Add for Firestore
    "ui": { "port": 4001 },
    "hub": { "port": 4401 }
  }
}