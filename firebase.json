
{
  "functions": {
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "hosting": { "port": 9002 },
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "port": 4001 },
    "hub": { "port": 4401 }
  },
 "firestore": {
    "rules": "firestore.rules"
  }
}
