# Firebase Configuration (from Firebase Console)
# Note: no NEXT_PUBLIC_ prefix — these are inlined via the `env` block in next.config.mjs
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cloudflare Turnstile (Bot Verification)
# Public sitekey (safe to expose in frontend). The values below are Cloudflare's official
# "always passes" dummy test pair — safe to commit, they do not work against real traffic.
# Get real keys at https://dash.cloudflare.com/turnstile for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Turnstile Secret (server-only, NEVER expose to frontend). This is the dummy pair's matching
# test secret. In production the real secret is provisioned as a Firebase App Hosting secret
# named TURNSTILE_SECRET_KEY (see apphosting.yaml) — it is never committed as a plaintext env var.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Put the REAL production site key in `.env.production.local` (gitignored), not here and not in
# `.env.local` — `next build` prefers `.env.production.local` over `.env.local` for
# NEXT_PUBLIC_* vars, but only if no higher-priority source wins first. `process.env` (i.e. a
# value already exported in the shell running `next build`/`firebase deploy`) always outranks
# every `.env*` file — check `echo $NEXT_PUBLIC_TURNSTILE_SITE_KEY` in the deploying shell if the
# built site key doesn't match what's in `.env.production.local`. See docs/DEPLOY.md.

# PayPal Configuration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Secret key for server-side PayPal verification (Cloud Functions only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=
# Optional: Configure tier prices for PayPal validation
# PAYPAL_TIER1_AMOUNT=0.25
# PAYPAL_TIER1_CURRENCY=USD
# PAYPAL_TIER2_AMOUNT=1.00
# PAYPAL_TIER2_CURRENCY=USD

# IPFS Configuration (optional; uploads are skipped if unset)
IPFS_URL=https://ipfs.infura.io:5001
IPFS_AUTH_HEADER=
IPFS_INFURA_PROJECT_ID=
IPFS_INFURA_PROJECT_SECRET=
NEXT_PUBLIC_IPFS_URL=https://ipfs.infura.io:5001
